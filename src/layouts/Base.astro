---
import '../styles/global.css';
import { path } from '../data/topics';
interface Props { title?: string; description?: string; }
const {title = 'FRAME / NOTES — AI 영상 연출 가이드', description = '구도, 빛, 연기, 컷 연속성을 설계하는 한국어 AI 영상 연출 노트.'} = Astro.props;
const canonical = new URL(Astro.url.pathname.endsWith('/404/') ? path('404.html') : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={path('favicon.svg')} />
    <meta name="theme-color" content="#10120f" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="header"><div class="shell header-inner">
      <a class="wordmark" href={path()} aria-label="FRAME NOTES 홈"><span class="mark" aria-hidden="true"></span>FRAME <span class="slash">/</span> NOTES</a>
      <nav aria-label="주 메뉴">
        <a href={path('#guides')}>연출 가이드</a><a href={path('examples/')}>예시 영상</a><a href={path('prompts/')}>프롬프트 갤러리</a>
      </nav>

    </div></header>
    <main id="main"><slot /></main>
    <footer class="footer"><div class="shell footer-top"><a class="wordmark" href={path()}>FRAME <span class="slash">/</span> NOTES</a><p>장면을 구체적으로.<br />선택에는 이유를.</p></div><div class="shell footer-bottom"><span>AI 영상 제작 과정과 실습 결과를 다루는 한국어 연출 노트입니다.</span></div></footer>
  </body>
</html>
