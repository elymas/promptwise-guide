---
import Diagram from './Diagram.astro';
import { path, type Topic } from '../data/topics';
import mediaData from '../data/media.json';
interface Props { topic: Topic; }
const {topic} = Astro.props;
const media = (mediaData as Record<string,{poster:string|null;video:string|null}>)[topic.slug];
---
<a class="guide-card" href={path(`guides/${topic.slug}/`)} style={`--card-accent:${topic.accent}`}>
  {media?.poster ? <div class="card-photo"><img src={path(media.poster)} alt={`${topic.title} — Claire 장면 스틸`} width="1280" height="720" loading="lazy" /><span>{media.video ? 'CLAIRE / VIDEO STUDY' : 'CLAIRE / SCENE STUDY'}</span></div> : <Diagram kind={topic.slug} accent={topic.accent} />}
  <div class="card-body"><div class="eyebrow"><span>{topic.number} / {topic.english}</span><span class="arrow" aria-hidden="true">↗</span></div><h3>{topic.title}</h3><p>{topic.summary}</p><div class="tags">{topic.sources.slice(0,3).map(id => <span>{id}</span>)}{topic.sources.length>3 && <span>+{topic.sources.length-3}</span>}</div></div>
</a>
