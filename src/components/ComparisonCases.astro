---
import cases from '../data/comparison-cases.json';
import catalog from '../data/catalog.json';
import {path} from '../data/topics';

interface Props { topic: string }
const {topic} = Astro.props;
const items = cases.filter(item => item.topic === topic);
const availableBlocks = new Set(catalog.prompts.map(prompt => prompt.id));
const audioLabels: Readonly<Record<string, string>> = {
  native: '테이크의 생성 원음',
  'edited-original': '생성 원음 사용 · 편집본',
  'gain-adjusted': '테이크의 생성 원음 · 검토용 +14 dB',
  reference: '다른 영상의 환경음',
  silent: '무음',
};
const views = [
  { value: 'a', label: 'A' },
  { value: 'b', label: 'B' },
  { value: 'both', label: '두 영상 보기' },
];
---
{items.length > 0 && <section class="comparison-cases" aria-label="프롬프트 전후 비교">
  <h3>프롬프트 전후 비교</h3>
  {items.map(item => <details id={`compare-${item.id}`}>
    <summary>{item.title}</summary>
    {item.a.video && item.b.video && <div class="comparison-controls" hidden>
      <div class="view-options" role="group" aria-label="A/B 화면 선택">
        {views.map(view => <button type="button" data-view={view.value} aria-controls={`takes-${item.id}`} aria-pressed={view.value === 'both'}>{view.label}</button>)}
      </div>
      <p>A와 B를 바꾸면 같은 재생 시각에서 멈춥니다.</p>
      {item.cues && <div class="view-options cue-options" role="group" aria-label="A/B에서 같은 관찰 시각으로 이동">
        {item.cues.map(cue => <button type="button" data-cue={cue.seconds} aria-controls={`takes-${item.id}`}>{cue.seconds.toFixed(2)}초 · {cue.label}</button>)}
      </div>}
    </div>}
    <div id={`takes-${item.id}`} class="takes">
      {[item.a, item.b].map((take, i) => <figure>
        <figcaption>
          {i === 0 ? 'A · 기준 장면' : 'B · 비교 장면'} · {take.resolution}
          {take.audio && <span class="audio-label">{audioLabels[take.audio]}</span>}
        </figcaption>
        {take.video ? <video controls playsinline preload="none" poster={path(take.poster)} aria-label={`${item.title} ${i === 0 ? 'A' : 'B'}`}>
          <source src={path(take.video)} type="video/mp4" />
          {take.captions && <track kind="captions" src={path(take.captions)}
            srclang={take.captionLanguage ?? 'ko'}
            label={take.captionLabel ?? (take.captionLanguage === 'en' ? 'English captions' : take.captionLanguage === 'ko' ? '한국어 자막' : '한국어 소리 설명')} />}
        </video> : <img src={path(take.poster)} alt={`${item.title} ${i === 0 ? 'A' : 'B'}`} loading="lazy" />}
      </figure>)}
    </div>
    <dl>
      <dt>비교한 연출 지시</dt><dd>{item.change}</dd>
      <dt>볼 지점</dt><dd>{item.watch}</dd>
      {item.dialogue && <><dt>확인한 대사</dt><dd><ul class="dialogue">{item.dialogue.map(line => <li>{line}</li>)}</ul></dd></>}
      <dt>검수 메모</dt><dd>{item.note}</dd>
    </dl>
    {item.inputs?.length > 0 && <details class="comparison-inputs">
      <summary>실제로 사용한 입력문</summary>
      {item.inputs.map(input => <div><h4>{input.label}</h4><pre>{input.prompt}</pre></div>)}
    </details>}
    <div class="study-links">
      <a class="text-link" href={path(item.review)}>실제 입력문·상세 기록 ↗</a>
      {item.sources.filter(source => availableBlocks.has(source)).map(source =>
        <a class="text-link" href={path(`prompts/?page=${source.split('-p')[0]}#${source}`)}>{source} ↗</a>
      )}
    </div>
  </details>)}
</section>}
<script>
  const narrow = matchMedia('(max-width: 520px)');

  document.querySelectorAll<HTMLElement>('.comparison-controls').forEach(controls => {
    const options = controls.querySelectorAll<HTMLButtonElement>('[data-view]');
    const card = controls.closest('details');
    const takes = card?.querySelector<HTMLElement>('.takes');
    if (!takes) return;

    const figures = [...takes.querySelectorAll('figure')];
    const [a, b] = figures.map(figure => figure.querySelector('video'));
    if (!a || !b) return;

    let currentVideo: HTMLVideoElement | undefined;
    let userSelected = false;
    const seek = (video: HTMLVideoElement, time: number) => {
      if (time > 0 && video.readyState === HTMLMediaElement.HAVE_NOTHING) video.preload = 'metadata';
      video.currentTime = Number.isFinite(video.duration) ? Math.min(time, video.duration) : time;
    };
    const select = (view: string) => {
      const target = view === 'a' ? a : view === 'b' ? b : undefined;
      const time = currentVideo?.currentTime ?? 0;
      if (!a.paused) a.pause();
      if (!b.paused) b.pause();

      takes.classList.toggle('single-take', !!target);
      figures[0].hidden = target === b;
      figures[1].hidden = target === a;
      options.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.view === view)));

      if (target && currentVideo && currentVideo !== target && target.currentTime !== time) {
        seek(target, time);
      }
      if (target) currentVideo = target;
    };
    const applyDefault = () => {
      if (!userSelected) select(narrow.matches ? 'a' : 'both');
    };

    for (const video of [a, b]) {
      video.addEventListener('play', () => { currentVideo = video; });
      video.addEventListener('seeking', () => {
        if (!video.closest('figure')?.hidden) currentVideo = video;
      });
    }
    options.forEach(button => button.addEventListener('click', () => {
      userSelected = true;
      select(button.dataset.view || 'both');
    }));
    controls.querySelectorAll<HTMLButtonElement>('[data-cue]').forEach(button => button.addEventListener('click', () => {
      const time = Number(button.dataset.cue);
      a.pause();
      b.pause();
      seek(a, time);
      seek(b, time);
    }));
    narrow.addEventListener('change', applyDefault);
    applyDefault();
    controls.hidden = false;
  });
</script>
<style>
  .comparison-cases { margin-top: 2rem; }
  h3 { font-size: 1.1rem; margin-bottom: .8rem; }
  details { border-top: 1px solid currentColor; padding: .8rem 0; scroll-margin-top: 6rem; }
  summary { cursor: pointer; }
  .comparison-controls { margin-top: 1rem; }
  .view-options { display: flex; flex-wrap: wrap; gap: .35rem; }
  .view-options button { min-width: 44px; min-height: 44px; padding: .35rem .7rem; border: 1px solid var(--line); color: var(--ink); background: var(--surface); cursor: pointer; }
  .view-options button[aria-pressed='true'] { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .cue-options { margin-block-start: .55rem; }
  .comparison-controls p { margin: .35rem 0 0; color: var(--muted); font-size: .82rem; }
  .takes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; margin-top: 1rem; }
  .takes.single-take { grid-template-columns: 1fr; }
  figure { margin: 0; min-width: 0; }
  figcaption { margin-bottom: .35rem; font-size: .8rem; }
  .audio-label { display: block; color: var(--muted); }
  video, img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; background: #10120f; }
  img { aspect-ratio: auto; }
  dl { margin: 1rem 0; font-size: .88rem; }
  dt { font-weight: 700; margin-top: .6rem; }
  dd { margin: .2rem 0 0; }
  .dialogue { margin: 0; padding: 0; list-style: none; }
  .comparison-inputs { margin-bottom: .9rem; }
  .comparison-inputs h4 { margin: .75rem 0 .3rem; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .82rem; }
  @media (max-width: 520px) { .takes { grid-template-columns: 1fr; } }
</style>
