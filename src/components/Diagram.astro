---
interface Props { kind: string; accent?: string; }
const {kind, accent = '#d6e895'} = Astro.props;
---
<div class={`diagram diagram-${kind}`} style={`--diagram-accent:${accent}`} aria-hidden="true">
  <span class="diagram-label">SHOT STUDY</span>
  {kind === 'depth' && <svg viewBox="0 0 500 250"><path d="M55 220V40h65v180M170 210V70h100v140M320 190V95h125v95"/><path class="dashed" d="M50 210L445 120M50 40L445 120"/><circle cx="220" cy="120" r="23"/><path d="M186 190v-28q34-35 68 0v28"/><text x="69" y="239">01</text><text x="206" y="239">02</text><text x="363" y="239">03</text></svg>}
  {kind === 'light' && <svg viewBox="0 0 500 250"><circle class="fill" cx="75" cy="75" r="25"/><path class="dashed" d="M105 65L229 100M105 90L227 152"/><ellipse cx="260" cy="115" rx="42" ry="55"/><path d="M260 60v110M200 220v-14q60-63 120 0v14M405 102v72M380 102h50l-12-30h-26z"/><text x="58" y="222">KEY</text><text x="374" y="222">WARM</text></svg>}
  {kind === 'contact' && <svg viewBox="0 0 500 250"><path d="M55 190h390M100 178l60-15 35 8 35-27 35 28 40-10 95 16M245 45v64q0 21-13 21t-13-21V45M245 55q13-10 20 3v45M265 66q15-12 22 3v39M287 80q16-9 20 6v35q0 19-20 37"/><circle class="dashed" cx="232" cy="143" r="42"/><text x="173" y="230">CAUSE → RESPONSE</text></svg>}
  {kind === 'camera' && <svg viewBox="0 0 500 250"><ellipse class="dashed" cx="250" cy="155" rx="160" ry="58"/><circle cx="250" cy="87" r="22"/><path d="M215 176v-43q35-34 70 0v43M100 166l-24 13v-41l24 13v-13h36v40h-36zM403 115l-26 14v-40l26 12V90h35v39h-35zM143 93q72-56 158-28l-15-18M301 65l-26 6"/><text x="214" y="237">ORBIT 30°</text></svg>}
  {kind === 'performance' && <svg viewBox="0 0 500 250"><path d="M50 192h400M85 175v34M195 175v34M305 175v34M415 175v34"/><circle cx="168" cy="85" r="35"/><path d="M154 89h4M175 89h4M155 106h22M133 82L80 67M280 73v49M301 73v49M365 100q23 20 46 0"/><text x="62" y="239">LISTEN</text><text x="235" y="239">PAUSE</text><text x="365" y="239">RESPOND</text></svg>}
  {kind === 'identity' && <svg viewBox="0 0 500 250"><rect x="65" y="45" width="145" height="160" rx="4"/><rect x="290" y="45" width="145" height="160" rx="4"/><circle cx="137" cy="100" r="24"/><circle cx="362" cy="105" r="37"/><path d="M104 177v-33q33-33 66 0v33M313 200v-33q49-43 98 0v33M230 124h40M260 114l10 10-10 10"/><text x="102" y="239">WIDE</text><text x="325" y="239">CLOSE</text></svg>}
  {kind === 'continuity' && <svg viewBox="0 0 500 250"><path d="M40 200h190M270 200h190M104 91h63v66q-32 17-63 0zM167 104h20q18 23-20 30M330 128h63v61q-32 17-63 0zM393 139h18q20 23-18 30M115 52v23M105 65l10 10 10-10M341 82v23M331 95l10 10 10-10M241 42v169"/><text x="72" y="235">RIGHT HAND</text><text x="305" y="235">RIGHT HAND</text></svg>}
  {kind === 'story' && <svg viewBox="0 0 500 250"><path d="M55 190h390M70 172l86-39 86-42 88-51 95 122"/><circle class="fill" cx="70" cy="172" r="7"/><circle class="fill" cx="156" cy="133" r="7"/><circle class="fill" cx="242" cy="91" r="7"/><circle class="fill" cx="330" cy="40" r="7"/><circle class="fill" cx="425" cy="162" r="7"/><text x="57" y="222">01</text><text x="145" y="222">02</text><text x="229" y="222">03</text><text x="316" y="222">04</text><text x="412" y="222">05</text></svg>}
</div>
