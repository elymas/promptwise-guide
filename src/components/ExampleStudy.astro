---
import Diagram from './Diagram.astro';
import {path, type Topic} from '../data/topics';
import {media} from '../data/media';
interface Props {topic: Topic;}
const {topic} = Astro.props;
const item = media[topic.slug];
const descriptionId = `study-${topic.slug}-description`;
---
<div class="study-heading"><p class="eyebrow">{item.studyLabel}</p><span class="status" data-state={item.status}>{item.statusLabel}</span></div>
{item.video ? <video controls playsinline preload="none" poster={item.poster ? path(item.poster) : undefined} width="854" height="480" aria-label={`${item.cast.join('·')} — ${item.studyLabel}`} aria-describedby={descriptionId}>
  <source src={path(item.video)} type="video/mp4" />
  {item.captions && <track kind="captions" src={path(item.captions)} srclang="ko" label={item.captionLabel ?? '한국어 자막·소리 설명'} />}
  동영상을 재생하려면 브라우저를 업데이트하세요.
</video> : <Diagram kind={topic.slug} accent={topic.accent} />}
<p class="example-caption">{item.caption}</p>
{item.video && <p class="muted small-text">{item.model} · {item.resolution} · 약 {Math.round(item.duration)}초 · {item.audioLabel}</p>}
<div class="evidence-note" id={descriptionId}><strong>관찰할 순간</strong><p>{item.watchFor}</p><p>{item.reviewNote}</p></div>
<p class="study-scope">{item.coverageScope}</p>
<div class="study-links"><a class="text-link" href={path(item.reviewUrl)}>{item.video ? '비교·프롬프트·제작 기록' : '주요 프롬프트 제작 계획'} ↗</a>{item.related.map(link=><a class="text-link" href={path(link.href)}>{link.label} ↗</a>)}</div>
{item.video && <details class="study-description"><summary>영상 내용과 소리 설명</summary><p>{item.description}</p><p>{item.audioLabel}</p></details>}
<details class="archive-record" id={`archive-${topic.slug}`}><summary>초기 무음 초안 기록</summary><p class="muted small-text">2026.11.18 초기 제작본 · 최종 확정본과 구분한 기록입니다.</p><video controls playsinline preload="none" poster={path(item.archive.poster)} width="854" height="480" aria-label={`${topic.title} — 초기 무음 초안`}><source src={path(item.archive.video)} type="video/mp4" /></video><p class="muted small-text">약 {Math.round(item.archive.duration)}초 · 무음. {item.archive.reviewNote}</p></details>
<script>
  document.addEventListener('play', event => {
    const active = event.target;
    if (!(active instanceof HTMLVideoElement)) return;
    document.querySelectorAll<HTMLVideoElement>('.example-block video, .example-review-card video').forEach(video => {
      if (video !== active) video.pause();
    });
  }, true);
</script>
