---
import Base from '../../layouts/Base.astro';
import ExampleStudy from '../../components/ExampleStudy.astro';
import {topics, path} from '../../data/topics';
import catalog from '../../data/catalog.json';
export function getStaticPaths() { return topics.map(topic => ({params:{slug:topic.slug},props:{topic}})); }
const {topic} = Astro.props;
const next = topics[(topics.findIndex(t=>t.slug===topic.slug)+1)%topics.length];
const sources = catalog.pages.filter(p=>topic.sources.includes(p.id));
const count = catalog.prompts.filter(p=>topic.sources.includes(p.page_id)).length;
---
<Base title={`${topic.title} — FRAME / NOTES`} description={topic.summary}>
  <div class="shell detail-header"><a class="back" href={path('#guides')}>← 모든 연출 가이드</a><p class="eyebrow">FIELD NOTE {topic.number} / {topic.english}</p><h1>{topic.title}</h1><p class="detail-intro">{topic.summary}</p><div class="tags"><span>연출 가이드</span><span>원리·템플릿</span><span>{count}개 출처 블록</span></div></div>
  <div class="shell detail-layout"><article>
    <section class="example-block"><div class="section-heading small"><h2>장면에서 확인하기</h2><a class="text-link" href={path(`examples/coverage/#${topic.slug}`)}>주요 프롬프트 제작 현황 ↗</a></div><ExampleStudy topic={topic} /><p><a class="text-link" href={path(`examples/#${topic.slug}`)}>이 주제의 비교 예시 모아보기 ↗</a></p></section>
    {topic.slug === 'performance' && <section class="detail-section" id="facial-actions"><h2>표정의 시작과 회복을 쓰다</h2><p>PW-107은 AU라는 번호와 함께 눈가·볼·입꼬리가 어떻게 움직이는지 쓰고, 시작·정점·회복을 시간으로 지정합니다. 의례적인 미소는 입꼬리만 가볍게 올리고, 마음에서 우러난 미소는 볼과 눈가가 먼저 움직인 뒤 입꼬리가 따라옵니다.</p><p>대사 중에는 눈과 눈썹으로 감정을 표현하고, 입의 강한 변화는 대사 사이에 둡니다. 자체 480p A/B에서는 2.5초 무렵 B의 볼과 눈가 움직임이 더 크게 보입니다. A에서도 볼이 움직여 동작 전체가 구분된 것은 아닙니다.</p><a class="text-link" href={path('prompts/?page=PW-107')}>FACS 원문과 복사 블록 12개 ↗</a><a class="text-link" href={path('examples/#compare-FACS')}>미소의 480p A/B 비교 ↗</a></section>}
    <section class="detail-section" id="principles"><p class="eyebrow">THE PRINCIPLE</p><h2>먼저 결정할 것</h2><div class="numbered-notes">{topic.principles.map((text,i)=><div><span>0{i+1}</span><p>{text}</p></div>)}</div></section>
    <section class="detail-section" id="workflow"><p class="eyebrow">THE WORKFLOW</p><h2>장면에 적용하는 순서</h2><ol class="steps">{topic.steps.map(step=><li>{step}</li>)}</ol></section>
    <section class="detail-section" id="template"><div class="section-heading small"><div><p class="eyebrow">YOUR STARTING POINT</p><h2>응용 템플릿</h2></div><button class="copy-button" type="button" data-copy aria-label="응용 템플릿 복사">복사하기 ↗</button></div><div class="template-box"><pre data-prompt>{topic.prompt}</pre></div><p class="muted small-text">가이드 원리를 바탕으로 작성한 응용 템플릿입니다. 대괄호를 장면에 맞게 바꾸고, 적용한 모델에서 결과를 확인하세요.</p></section>
    <section class="detail-section" id="checks"><p class="eyebrow">LOOK CLOSER</p><h2>결과에서 확인할 것</h2><ul class="check-list">{topic.checks.map(text=><li>{text}</li>)}</ul><div class="evidence-note"><strong>검증 범위</strong><p>이 페이지는 출처의 지침을 한국어로 정리한 참조 자료입니다. 프로젝트에서 조명·시선·소품 배치의 개선이 일부 관찰됐지만, 이 섹션의 모든 기법이 검증된 것은 아닙니다. 새 Claire 예시는 제작·검수 상태를 별도로 표시합니다.</p></div></section>
    <section class="detail-section" id="sources"><p class="eyebrow">READ THE SOURCE</p><h2>원문과 더 많은 블록</h2><div class="source-list">{sources.map(s=><a href={path(`prompts/?page=${s.id}`)}><span>{s.id}</span><div><strong>{s.title}</strong><p>{s.topic_ko}</p></div><span>{s.count}개 ↗</span></a>)}</div><p class="muted small-text">원출처: PromptWise · 원출처 확인 2026.11.20 · 번호 1–500 점검</p></section>
  </article><aside class="detail-aside"><span class="eyebrow">IN THIS NOTE</span><a href="#principles">먼저 결정할 것</a><a href="#workflow">적용 순서</a><a href="#template">응용 템플릿</a><a href="#checks">결과 검수</a><a href="#sources">출처 블록</a><hr /><p>한 번에 한 가지를 바꾸고,<br />그 결과를 기록하세요.</p><a class="button outline" href={path(`prompts/?topic=${topic.slug}`)}>관련 블록 찾기 ↗</a></aside></div>
  <div class="shell next-note"><span class="eyebrow">NEXT FIELD NOTE</span><a href={path(`guides/${next.slug}/`)}>{next.number} / {next.title} <span>→</span></a></div>
  <div class="toast" role="status" aria-live="polite"></div>
  <script>import '../../scripts/copy';</script>
</Base>
