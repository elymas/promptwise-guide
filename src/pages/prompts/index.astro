---
import Base from '../../layouts/Base.astro';
import { topics, path } from '../../data/topics';
---
<Base title="연출 템플릿 — FRAME / NOTES" description="장면을 설계하는 여덟 가지 연출 템플릿입니다.">
  <section class="shell page-heading"><h1>연출 템플릿</h1><p>장면에 필요한 항목을 골라 가이드의 응용 템플릿을 사용하세요.</p></section>
  <section class="shell coverage-section">
    <ul>
      {topics.map(topic => <li><a class="text-link" href={path(`guides/${topic.slug}/#template`)}>{topic.title} ↗</a></li>)}
    </ul>
  </section>
</Base>
