---
import Base from '../../layouts/Base.astro';
import { topics, path } from '../../data/topics';
---
<Base title="프롬프트 갤러리 — FRAME / NOTES" description="장면을 설계하는 여덟 가지 연출 템플릿입니다.">
  <section class="shell page-heading"><h1>프롬프트 갤러리</h1><p>주제를 고르면 장면에 맞게 바꿔 쓸 수 있는 프롬프트가 열립니다.</p></section>
  <section class="shell coverage-section">
    <ul>
      {topics.map(topic => <li><a class="text-link" href={path(`guides/${topic.slug}/#template`)}>{topic.title} ↗</a></li>)}
    </ul>
  </section>
</Base>
