---
import Base from '../../layouts/Base.astro';
import { topics, path } from '../../data/topics';
---
<Base title="프롬프트 갤러리 — FRAME / NOTES" description="구도·조명·연기 등 여덟 가지 주제의 프롬프트 예시를 찾아보세요.">
  <section class="shell page-heading"><h1>프롬프트 갤러리</h1><p>주제를 고르면 프롬프트 예시를 읽고 복사할 수 있습니다.</p></section>
  <section class="shell coverage-section">
    <ul>
      {topics.map(topic => <li><a class="text-link" href={path(`guides/${topic.slug}/#template`)}>{topic.title} ↗</a></li>)}
    </ul>
  </section>
</Base>
