---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import {topics,path} from '../../data/topics';
---
<Base title="프롬프트 라이브러리 — FRAME / NOTES" description="282개 PromptWise 참조 블록을 주제, 페이지, 키워드로 찾고 원문을 복사하세요.">
  <section class="shell page-heading"><p class="eyebrow">THE REFERENCE LIBRARY</p><h1>필요한 한 문장을 찾다.</h1><p>{catalog.pages.length}개 내용 버전 · {catalog.prompts.length}개 참조 블록.<br />완성 프롬프트부터 짧은 지시문, 개선 예시까지.</p></section>
  <div class="shell search-layout"><aside class="filter-panel"><label for="topic-filter" class="eyebrow">BROWSE BY CRAFT</label><select id="topic-filter"><option value="">모든 연출 주제</option>{topics.map(t=><option value={t.slug}>{t.number} / {t.english}</option>)}</select><label for="page-filter" class="eyebrow">SOURCE PAGE</label><select id="page-filter"><option value="">모든 출처 페이지</option>{catalog.pages.map(p=><option value={p.id}>{p.id} · {p.title}</option>)}</select><button class="reset-filter" type="button">필터 초기화 ↺</button><p class="muted small-text">원문은 영어입니다. 한국어 주제와 키워드도 함께 검색합니다.</p><a class="text-link" href={path('data/catalog.json')} download>전체 JSON 내려받기 ↗</a><a class="text-link" href={path('library/')}>집계와 출처 안내 ↗</a></aside><section class="search-results" aria-label="프롬프트 검색 결과"><div class="search-bar"><label class="sr-only" for="search">프롬프트 검색</label><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="무엇을 연출하고 싶나요? 예: camera, 시선, light" autocomplete="off" /><kbd>/</kbd></div><div class="result-meta"><span role="status" id="result-count" aria-live="polite">{catalog.prompts.length}개 블록</span><span>원출처 · PROMPTWISE</span></div><div class="empty-results" hidden><h2>일치하는 블록이 없습니다.</h2><p>키워드를 줄이거나 출처·주제 필터를 바꿔보세요.</p><button class="button outline reset-filter" type="button">전체 블록 보기</button></div><div id="prompt-list">{catalog.prompts.map(p=><article class="prompt-card" data-card data-page={p.page_id} data-topics={topics.filter(t=>t.sources.includes(p.page_id)).map(t=>t.slug).join(' ')} id={p.id}><div class="prompt-top"><a class="prompt-id" href={`#${p.id}`}>{p.id}</a><span class="prompt-kind">{p.label}</span><button class="copy-button" type="button" data-copy aria-label={`${p.id} 프롬프트 복사`}>복사 ↗</button></div><h2>{p.subject || p.section || p.page_title}</h2><p class="prompt-context">{p.topic_ko}</p><details><summary>원문 펼치기 <span aria-hidden="true">+</span></summary><pre data-prompt>{p.prompt}</pre></details><div class="prompt-source"><span>{p.page_title}</span><a href={p.source_url} target="_blank" rel="noopener noreferrer">원출처 보기 ↗</a></div></article>)}</div></section></div><div class="toast" role="status" aria-live="polite"></div>
  <script>
    import '../../scripts/copy';
    const q = document.querySelector<HTMLInputElement>('#search')!;
    const topic = document.querySelector<HTMLSelectElement>('#topic-filter')!;
    const page = document.querySelector<HTMLSelectElement>('#page-filter')!;
    const count = document.querySelector<HTMLElement>('#result-count')!;
    const empty = document.querySelector<HTMLElement>('.empty-results')!;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
    const search = new Map(cards.map(c=>[c,(c.textContent||'').toLocaleLowerCase()]));
    function filter(updateUrl=true) {
      const words=q.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);let n=0;
      cards.forEach(c=>{c.hidden=Boolean((page.value&&c.dataset.page!==page.value)||(topic.value&&!c.dataset.topics?.split(' ').includes(topic.value))||!words.every(w=>search.get(c)?.includes(w)));if(!c.hidden)n++;});
      count.textContent=`${n} / ${cards.length}개 블록`;empty.hidden=n!==0;
      if(updateUrl){const url=new URL(location.href);for(const [k,v]of [['q',q.value],['topic',topic.value],['page',page.value]]){v?url.searchParams.set(k,v):url.searchParams.delete(k);}history.replaceState(null,'',url);}
    }
    const params=new URLSearchParams(location.search);q.value=params.get('q')||'';topic.value=params.get('topic')||'';page.value=params.get('page')||'';
    q.addEventListener('input',()=>filter());topic.addEventListener('change',()=>filter());page.addEventListener('change',()=>filter());
    document.querySelectorAll('.reset-filter').forEach(b=>b.addEventListener('click',()=>{q.value='';topic.value='';page.value='';filter();q.focus();}));
    document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes((document.activeElement as HTMLElement)?.tagName)){e.preventDefault();q.focus();}});
    function reveal(){const id=decodeURIComponent(location.hash.slice(1));const card=document.getElementById(id);if(card?.matches('[data-card]')){q.value='';page.value='';topic.value='';filter();(card.querySelector('details') as HTMLDetailsElement).open=true;requestAnimationFrame(()=>card.scrollIntoView({block:'start'}));}}
    filter(false);reveal();window.addEventListener('hashchange',reveal);
  </script>
</Base>
