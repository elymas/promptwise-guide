---
import Base from '../../layouts/Base.astro';
import { topics, path } from '../../data/topics';
import coverage from '../../data/example-coverage.json';

const decisions = [...coverage.examples, ...coverage.additional];
const visible = decisions.filter(item => ['채택','부분 채택'].includes(item.decision)).length;
const outstanding = decisions.filter(item => ['재작업','보류'].includes(item.decision));
const excluded = decisions.filter(item => item.decision === '제외').length;
const asOf = coverage.as_of.replaceAll('-', '.');
const groups = [
  ...topics.map(topic => ({id:topic.slug,title:topic.title,guide:topic.slug,items:coverage.examples.filter(item => item.topic === topic.slug)})),
  {id:'additional-480p',title:'보조 사례',guide:null,items:coverage.additional},
];
---
<Base noindex title="제작·검수 현황 — FRAME / NOTES" description="장면별 판정·테이크·사용 범위와 재작업 상태를 확인합니다.">
  <section class="shell page-heading">
    <h1>제작·검수 현황</h1>
    <p>{asOf} · {decisions.length}개 판정 · 채택·부분 채택 {visible}개 · 재작업·보류 {outstanding.length}개 · 제외 {excluded}개</p>
    <div class="study-links">
      <a class="text-link" href={path('examples/')}>공개 예시 ↗</a>
      <a class="text-link" href="#next-production">재작업과 보류 ↘</a>
      <a class="text-link" href={path('data/example-coverage.json')} download>판정 JSON ↗</a>
    </div>
    <nav class="coverage-nav" aria-label="검수 주제">
      {groups.map(group => <a href={`#${group.id}`}>{group.title}</a>)}
    </nav>
  </section>
  {groups.map(group => (
    <section class="shell coverage-section" id={group.id}>
      <div class="section-heading small">
        <h2>{group.title}</h2>
        {group.guide && <a class="text-link" href={path(`guides/${group.guide}/`)}>연출 가이드 ↗</a>}
      </div>
      <ul class="coverage-items" role="list">
        {group.items.map(item => <li class="coverage-item" id={item.id} tabindex="-1">
          <h3><span class="eyebrow">{item.id}</span> {item.title}</h3>
          <p class="coverage-state">{item.decision} · {item.use}{item.selected ? ` · ${item.selected}` : ''}</p>
          {item.decisionNote && <p class="coverage-note">{item.decisionNote}</p>}
          {item.links.length > 0 && <ul class="coverage-links" role="list">
            {item.links.map(link => <li><a href={path(link.href)}>{link.label} ↗</a></li>)}
          </ul>}
        </li>)}
      </ul>
    </section>
  ))}
  <section class="shell coverage-section" id="next-production">
    <h2>재작업과 보류</h2>
    <ul>{outstanding.map(item => <li><a class="text-link" href={`#${item.id}`}>{item.id} · {item.title}</a></li>)}</ul>
  </section>
  <section class="shell coverage-section" id="reference-roles">
    <h2>참조 역할을 배정한 두 요청</h2>
    <a class="text-link" href={path('review/reference-roles/')}>E18 참조 입력과 결과 ↗</a>
  </section>
</Base>
<style>
  .coverage-nav { display:flex; flex-wrap:wrap; gap:.65rem; }
  .coverage-nav a { display:inline-flex; align-items:center; min-height:44px; }
  .coverage-items,.coverage-links { margin:0; padding:0; list-style:none; }
  .coverage-items { display:grid; gap:.8rem; }
  .coverage-item { min-width:0; padding:1.15rem; border:1px solid var(--line); border-radius:4px; background:var(--surface); scroll-margin-top:6rem; }
  .coverage-item:target { border-color:var(--accent); }
  .coverage-item h3 { font-size:1.15rem; }
  .coverage-item h3 .eyebrow { display:block; margin-bottom:.25rem; }
  .coverage-state { margin:.55rem 0 .4rem; font-weight:600; font-size:.9rem; }
  .coverage-links a { display:inline-flex; align-items:center; min-height:44px; color:var(--accent); text-decoration:underline; }
  .coverage-note { margin:.6rem 0 0; color:var(--muted); font-size:.9rem; }
  @media (min-width:720px) { .coverage-items { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (min-width:1000px) { .coverage-items { grid-template-columns:repeat(3,minmax(0,1fr)); } }
</style>
