---
import Base from '../../layouts/Base.astro';
import {topics,path} from '../../data/topics';
import mediaData from '../../data/media.json';
type Media = {status:string;video:string|null;poster:string|null;duration:number;model:string|null;resolution:string|null;reviewed:boolean;reviewNote?:string};
const media = mediaData as Record<string,Media>;
const ready = topics.filter(t=>media[t.slug].video).length;
---
<Base title="Claire 예시 영상 — FRAME / NOTES" description="같은 인물 Claire로 구도·빛·접촉·카메라·연기·컷 연결을 실험한 8개 짧은 예시.">
  <section class="shell page-heading"><p class="eyebrow">ONE CHARACTER / EIGHT DIRECTING DECISIONS</p><h1>같은 Claire.<br />여덟 가지 연출.</h1><p>섹션마다 하나의 선택을 관찰하는 짧은 무음 예시입니다.<br />{ready} / 8개 영상 · 초안과 최종본은 구분해 표시합니다.</p></section>
  <section class="shell examples-grid" aria-label="Claire 섹션별 예시">{topics.map(topic=>{const item=media[topic.slug];return <article class="example-review-card"><div class="section-heading small"><div><p class="eyebrow">{topic.number} / {topic.english}</p><h2>{topic.title}</h2></div><span class="status">{item.video ? (item.status==='draft'?'480p 초안':'생성 예시'):'준비 중'}</span></div>{item.video ? <video controls playsinline preload="none" poster={item.poster ? path(item.poster):undefined} width="1280" height="720"><source src={path(item.video)} type="video/mp4" /></video> : item.poster ? <img src={path(item.poster)} alt={`${topic.title} Claire 장면 스틸`} width="1280" height="720" loading="lazy" /> : <p class="muted">예시 제작 준비 중입니다.</p>}<p class="example-caption">{topic.example}</p>{item.reviewNote&&<div class="evidence-note"><strong>초안 관찰</strong><p>{item.reviewNote}</p></div>}<div class="example-review-meta"><span>{item.video?`${item.model} · ${item.resolution} · ${item.duration}초 · 무음`:'새 장면 제작'}</span><a class="text-link" href={path(`guides/${topic.slug}/`)}>연출 가이드 ↗</a></div></article>})}</section>
</Base>
