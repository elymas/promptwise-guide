---
import Base from '../../layouts/Base.astro';
import ExampleStudy from '../../components/ExampleStudy.astro';
import ComparisonCases from '../../components/ComparisonCases.astro';
import {topics,path} from '../../data/topics';
import {media} from '../../data/media';
import cases from '../../data/comparison-cases.json';
const ready = topics.filter(t=>media[t.slug].video).length;
---
<Base title="장면별 예시 영상 — FRAME / NOTES" description="Claire와 Erin의 소리 있는 촬영·연기 예시, 확정 테이크와 A/B 비교 사례.">
  <section class="shell page-heading"><p class="eyebrow">CLAIRE & ERIN / EIGHT DIRECTING DECISIONS</p><h1>장면에서 찾는<br />여덟 가지 선택.</h1><p>대표 영상 {ready}개와 검수 사례 {cases.length}개를 주제별로 볼 수 있습니다.<br />카드를 펼쳐 판정·사용 범위와 실제 장면을 확인하세요.</p></section>
  <section class="shell" aria-label="확정 테이크"><div class="evidence-note"><strong>2026.11.19 ACT-05 B · ACT-10 확정</strong><p>시간차 반응의 영상과 B 고유 원음을 확정했습니다. 다른 테이크와 720p 최종본은 이 확정에 포함하지 않습니다.</p><div class="study-links"><a class="text-link" href={path('review/acting-v2/#ACT-05')}>확정 테이크와 A/B 비교 ↗</a><a class="text-link" href={path('review/acting-v2/#ACT-10')}>두 얼굴 동기 관찰 ↗</a></div></div></section>
  <section class="shell" aria-label="새 초점과 빛 비교"><div class="evidence-note"><strong>새 비교 초안 · 초점과 빛</strong><p>비 조명과 그림자는 실제 비교 초안으로 볼 수 있습니다. 두 테이블 로우앵글의 새 실사 이동 초안을 공개했습니다. 전경이 먼저 빠지는 차이를 볼 수 있으며, 중반 입·시선과 초점 편차는 검수 메모에 남겼습니다.</p><div class="study-links"><a class="text-link" href={path('examples/#compare-E02')}>E02 · 랙 포커스 480p ↗</a><a class="text-link" href={path('review/claire-performance-gate/')}>새4초 얼굴·시선 검사 ↗</a><a class="text-link" href={path('review/claire-reference-pack/')}>Claire 참조 팩 ↗</a><a class="text-link" href={path('review/optics-v1/#E03')}>역광의 비 ↗</a><a class="text-link" href={path('review/optics-v1/#E05')}>하드/소프트 그림자 ↗</a></div></div></section>
  <section class="shell"><div class="evidence-note"><strong>최근 촬영·연기 비교</strong><p>머리와 어깨 윤곽, 유리의 입김, 볼과 눈가의 미소를 비교할 수 있습니다.</p><div class="study-links"><a class="text-link" href={path('examples/#compare-E06')}>E06 · 머리와 어깨 윤곽 ↗</a><a class="text-link" href={path('examples/#compare-E08')}>E08 · 입김과 유리 반사 480p ↗</a><a class="text-link" href={path('examples/#compare-FACS')}>미소의 볼·눈가 움직임 비교 ↗</a></div></div></section>
  <section class="shell examples-grid" aria-label="섹션별 예시">{topics.map(topic=><article class="example-review-card" id={topic.slug}><div class="section-heading small"><div><p class="eyebrow">{topic.number} / {topic.english}</p><h2>{topic.title}</h2></div></div><ExampleStudy topic={topic} /><ComparisonCases topic={topic.slug} /><div class="example-review-meta"><a class="text-link" href={path(`guides/${topic.slug}/`)}>연출 가이드 ↗</a></div></article>)}</section>
  <script>
    function openLinkedComparison() {
      const id = location.hash.slice(1);
      if (!id.startsWith('compare-')) return;
      const card = document.getElementById(id);
      if (card instanceof HTMLDetailsElement) {
        card.open = true;
        card.scrollIntoView();
      }
    }
    openLinkedComparison();
    window.addEventListener('hashchange', openLinkedComparison);
  </script>
</Base>
