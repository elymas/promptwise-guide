---
import Base from '../../layouts/Base.astro';
import ExampleStudy from '../../components/ExampleStudy.astro';
import {topics,path} from '../../data/topics';
import {media} from '../../data/media';
const ready = topics.filter(t=>media[t.slug].video).length;
---
<Base title="장면별 예시 영상 — FRAME / NOTES" description="Claire와 Erin의 소리 있는 촬영·연기 예시, 확정 범위와 주요 프롬프트 제작 현황.">
  <section class="shell page-heading"><p class="eyebrow">CLAIRE & ERIN / EIGHT DIRECTING DECISIONS</p><h1>장면에서 찾는<br />여덟 가지 선택.</h1><p>소리 있는 예시 {ready}개와 이야기 구조 제작 계획을 연결했습니다.<br />확정 테이크·검토 초안·미제작 항목을 각각 표시합니다.</p></section>
  <section class="shell" aria-label="확정 범위와 주요 프롬프트"><div class="evidence-note"><strong>2026.11.19 ACT-05 B · ACT-10 확정</strong><p>시간차 반응의 영상과 B 고유 원음을 확정했습니다. 다른 테이크와 720p 최종본은 이 확정에 포함하지 않습니다.</p><div class="study-links"><a class="text-link" href={path('review/acting-v2/#ACT-05')}>확정 테이크와 A/B 비교 ↗</a><a class="text-link" href={path('review/acting-v2/#ACT-10')}>두 얼굴 동기 관찰 ↗</a><a class="text-link" href={path('examples/coverage/')}>주요 프롬프트 24개 제작 현황 ↗</a></div></div></section>
  <section class="shell" aria-label="새 초점과 빛 비교"><div class="evidence-note"><strong>새 비교 초안 · 초점과 빛</strong><p>비 조명과 그림자는 실제 비교 초안으로 볼 수 있습니다. 두 테이블 로우앵글의 새 실사 이동 초안을 공개했습니다. 전경이 먼저 빠지는 차이를 볼 수 있으며, 중반 입·시선과 초점 편차는 검수 메모에 남겼습니다.</p><div class="study-links"><a class="text-link" href={path('review/optics-low-angle-result/')}>E10 두 테이블 · 실사 이동 초안 ↗</a><a class="text-link" href={path('review/claire-performance-gate/')}>새4초 얼굴·시선 검사 ↗</a><a class="text-link" href={path('review/claire-reference-pack/')}>Claire 참조 팩 ↗</a><a class="text-link" href={path('review/optics-v1/#E03')}>역광의 비 ↗</a><a class="text-link" href={path('review/optics-v1/#E05')}>하드/소프트 그림자 ↗</a></div></div></section>
  <section class="shell examples-grid" aria-label="섹션별 예시">{topics.map(topic=><article class="example-review-card" id={topic.slug}><div class="section-heading small"><div><p class="eyebrow">{topic.number} / {topic.english}</p><h2>{topic.title}</h2></div></div><ExampleStudy topic={topic} /><div class="example-review-meta"><a class="text-link" href={path(`guides/${topic.slug}/`)}>연출 가이드 ↗</a></div></article>)}</section>
</Base>
