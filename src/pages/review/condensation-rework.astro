---
import Base from '../../layouts/Base.astro';
import { path } from '../../data/topics';
import manifest from '../../../public/review/condensation-rework/manifest.json';
import prompts from '../../../public/review/condensation-rework/still-prompt.json';
import plan from '../../../public/review/condensation-rework/video-plan.json';
import pilot from '../../../public/review/condensation-rework/480p-review.json';
import comparisons from '../../data/comparison-cases.json';
const currentInputs = comparisons.find(item => item.id === 'E08')?.inputs ?? [];
const [start, previous, target] = manifest.stills;
const views = [
  { ...previous, title: '기존 B · 2.00초 실제 프레임', note: '불투명한 흰 타원이 그 안의 입술 반사와 배경을 가립니다.' },
  { ...target, title: '응결의 새 기준 스틸', note: '미세한 물방울 사이로 입술 반사와 유리 너머 배경이 읽힙니다.' },
];
---
<Base title="입김이 유리에 남기는 흔적 — FRAME / NOTES" description="Tein 기존 초안과 반투명 응결 기준을 확대해 비교하고, 새 영상의 검수 조건을 공개합니다.">
  <section class="shell page-heading">
    <h1>입김 속에서도<br />유리 뒤가 보이게</h1>
    <p>Claire가 차가운 유리에 숨을 내쉽니다. 같은 위치를 확대해 흰 타원과 유리 표면에 맺힌 반투명 물기의 차이를 비교하세요.</p>
  </section>
  <section class="shell detail-pair" aria-label="기존 2초 프레임과 새 응결 기준 확대 비교">
    {views.map(view => (
      <figure>
        <a class="detail" href={path(view.path)} aria-label={`${view.title} · 전체 스틸 열기`}>
          <img src={path(view.path)} width={view.width} height={view.height} alt={view.note} />
        </a>
        <figcaption><strong>{view.title}</strong><br />{view.note}</figcaption>
      </figure>
    ))}
  </section>
  <section class="shell coverage-section">
    <h2>한 번의 숨 뒤에 생기고 가장자리부터 옅어집니다</h2>
    <p>초기 6초 제작안에서 두 편은 같은 구도와 맑은 유리 시작 스틸을 공유합니다. A는 숨을 한 번 내쉬도록 지시합니다. B는 숨이 닿은 뒤 물기가 나타나고, 배경의 대비만 조금 낮아지며, 3초부터 가장자리가 옅어지도록 씁니다.</p>
    <p>초기 영상 B에서는 응결이 흰 타원처럼 나타났습니다. 반투명 물기의 기준 스틸을 종료 프레임으로 추가해 B를 다시 만들었고, 아래에서 실제 수정본을 비교합니다.</p>
    <div class="study-links">
      <a class="text-link" href={path(start.path)}>두 편이 공유할 맑은 유리 스틸 ↗</a>
      <a class="text-link" href={path('examples/#compare-E08')}>현재 Tein A/B와 원음 ↗</a>
    </div>
  </section>
  <section class="shell coverage-section" id="pilot-480p">
    <h2>480p 수정본에서 보이는 반사</h2>
    <p>3.50초의 수정 B에는 옅은 물기가 있고 입술 반사와 건물 윤곽이 여전히 보입니다. 전체 화면에서는 두 편의 물기 차이가 작아 확대에서 더 잘 읽힙니다.</p>
    <div class="detail-pair" aria-label="새 A/B 3.5초의 유리 확대">
      {['A','B'].map((side) => (
        <figure>
          <img class="pilot-crop" src={path(`review/condensation-rework/media/480p-current-${side}-3.5s-glass.jpg`)} width="525" height="435" loading="lazy"
            alt={side === 'A' ? 'A 3.5초의 맑은 유리와 입술 반사' : 'B 3.5초의 반투명한 물기, 입술 반사와 배경이 비치는 유리'} />
          <figcaption>{side} · 현재 초안 3.50초 확대</figcaption>
        </figure>
      ))}
    </div>
    <div class="study-links">
      <a class="text-link" href={path('examples/#compare-E08')}>반투명 응결 480p A/B · 검토용 +14 dB ↗</a>
      <a class="text-link" href={path('review/condensation-rework/media/E08-480-A.mp4')}>A 게인 적용 전 ↗</a>
      <a class="text-link" href={path('review/condensation-rework/media/E08-480-B-END.mp4')}>B 게인 적용 전 ↗</a>
    </div>
    <h3>2.00초 · 첫 B와 수정 B</h3>
    <div class="detail-pair">
      <figure>
        <img class="pilot-crop" src={path('review/condensation-rework/media/480p-B-2s-glass.jpg')} width="525" height="435" loading="lazy" alt="첫 B의 흰 응결이 입술 반사를 가립니다." />
        <figcaption>첫 B · 흰 영역이 반사 위를 덮음</figcaption>
      </figure>
      <figure>
        <img class="pilot-crop" src={path('review/condensation-rework/media/480p-current-B-2s-glass.jpg')} width="525" height="435" loading="lazy" alt="수정 B의 유리에서 입술 반사와 건물 윤곽이 남아 있습니다." />
        <figcaption>수정 B · 같은 영역에 입술 반사와 건물 윤곽이 남음</figcaption>
      </figure>
    </div>
    <p>같은 유리 영역의 2.00초 평균 밝기는 첫 B에서 150.4, 수정 B에서 99.5였습니다. 0~255 회색조의 화면 밝기를 비교한 값입니다.</p>
    <details><summary>현재 480p A/B에 제출한 입력문</summary>{currentInputs.map(input => <div><h3>{input.label}</h3><pre lang="en">{input.prompt}</pre></div>)}</details>
    <details><summary>첫 480p B에 제출한 입력문</summary><pre lang="en">{pilot.prompts[1]}</pre></details>
  </section>
  <section class="shell coverage-section">
    <h2>스틸과 영상 입력문</h2>
    <p>응결 기준 스틸은 ChatGPT 내장 이미지 생성 도구로 만들었습니다. 아래 6초 입력안은 과거 설계 기록입니다.</p>
    <details><summary>스틸에 실제로 사용한 편집 입력문</summary><pre>{prompts.edit}</pre></details>
    <details><summary>초기 6초 A/B 입력안</summary><h3>공통</h3><pre>{plan.common}</pre><h3>A</h3><pre>{plan.variants.A}</pre><h3>B</h3><pre>{plan.variants.B}</pre></details>
    <div class="study-links">
      <a class="text-link" href={path('review/condensation-rework/manifest.json')} download>프레임 시각과 원본 검증 기록 ↗</a>

    </div>
  </section>
</Base>
<style>
  .detail-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  figure { margin: 0; }
  .detail { display: block; overflow: hidden; aspect-ratio: 4/3; background: var(--surface); }
  .detail img { display: block; width: 200%; max-width: none; height: auto; transform: translate(-37%,-24%); }
  .pilot-crop { display: block; width: 100%; height: auto; max-width: 525px; }
  figcaption { margin-top: .7rem; font-size: .9rem; color: var(--muted); }
  figcaption strong { color: var(--ink); }
  details { margin-block: .8rem; }
  summary { cursor: pointer; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 580px) { .detail-pair { grid-template-columns: 1fr; } }
</style>
