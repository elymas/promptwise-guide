---
import Base from '../../layouts/Base.astro';
import { path } from '../../data/topics';
import evidence from '../../../public/review/reference-roles/evidence.json';

const titles: Record<string, string> = {
  act05: 'ACT-05 B · 첫 프레임으로 장면 고정',
  geo: 'GEO-01 B · 장면과 카메라 경로를 나눠 참조',
};
const roles: Record<string, string> = {
  first_frame: '장면 사진을 영상의 첫 프레임에 지정',
  reference_image: '사진에서 인물·의상·작업실을 참조',
  reference_video: '3D 영상에서 카메라 경로와 타이밍을 참조',
};
const {shared_still: still, motion_reference: motion} = evidence;
---
<Base title="같은 장면 사진을 배정하는 두 방식 — FRAME / NOTES" description="Tein ACT-05와 GEO-01의 실제 참조 이미지 해시, 요청 필드, 결과 영상과 프레임을 연결합니다.">
  <section class="shell page-heading">
    <h1>장면을 정하는 사진,<br />이동을 정하는 영상</h1>
    <p>같은 작업실 사진으로 만든 두 실제 결과입니다. ACT-05 B는 사진을 첫 프레임에 지정하고 카메라 이동을 문장으로 지시했습니다. GEO-01 B는 사진에 장면을 맡기고 별도의 3D 영상에 카메라 경로를 맡겼습니다.</p>
  </section>
  <section class="shell coverage-section" aria-label="실제 제작 참조">
    <h2>참조로 사용한 두 파일</h2>
    <div class="reference-workflow">
      <figure>
        <img src={path(still.path)} width={still.width} height={still.height} alt="같은 선반과 하나의 작업대를 사이에 두고 마주 앉은 Claire와 Erin" />
        <figcaption>공통 장면 사진의 웹 표시용 사본 · 두 요청의 업로드 이미지 해시가 일치합니다.</figcaption>
      </figure>
      <figure>
        <video class="study-video" controls muted playsinline preload="none" poster={path(motion.poster)} width={motion.width} height={motion.height} aria-label="카메라 경로를 보여 주는 무음 3D 참조">
          <source src={path(motion.path)} type="video/mp4" />
        </video>
        <figcaption>GEO-01 B에 사용한 카메라 경로의 웹 재생용 사본 · 무음 · 960 × 540</figcaption>
      </figure>
    </div>
    <div class="result-cues" role="group" aria-label="두 결과의 같은 시각으로 이동" hidden>
      {evidence.workflows[0].samples.map(sample => (
        <button type="button" data-result-time={sample.seconds} aria-controls="result-act05 result-geo">
          두 결과 {sample.seconds.toFixed(2)}초로 이동
        </button>
      ))}
    </div>
  </section>
  {evidence.workflows.map(workflow => (
    <section class="shell coverage-section" id={workflow.id}>
      <h2>{titles[workflow.id]}</h2>
      <dl class="slots">
        {Object.keys(workflow.request_input_fields).map(field => <div>
          <dt><code>{field}</code></dt>
          <dd>{roles[field]}</dd>
        </div>)}
      </dl>
      <figure>
        <video id={`result-${workflow.id}`} class="study-video" data-result controls playsinline preload="none" poster={path(workflow.samples[0].path)} width={workflow.width} height={workflow.height} aria-label={titles[workflow.id]}>
          <source src={path(workflow.video)} type="video/mp4" />
        </video>
        <figcaption>{workflow.width} × {workflow.height} · {workflow.audio}</figcaption>
      </figure>
      <div class="sample-grid">
        {workflow.samples.map(sample => <figure>
          <img src={path(sample.path)} width={workflow.width} height={workflow.height} alt={sample.observation} loading="lazy" />
          <figcaption>{sample.seconds.toFixed(2)}초 · {sample.observation}</figcaption>
        </figure>)}
      </div>
      <details>
        <summary>Tein에 실제로 제출한 입력문</summary>
        <pre lang="en">{workflow.prompt}</pre>
      </details>
      <a class="text-link" href={path(workflow.result)}>제작 과정과 검수 기록 ↗</a>
    </section>
  ))}
  <section class="shell coverage-section">
    <h2>이 자료에서 확인할 수 있는 범위</h2>
    <p>업로드 기록과 실제 요청 필드에서 두 방식을 확인했습니다. 생성 결과에는 장면 참조 방식 외에도 카메라와 연기 지시의 차이가 있습니다. 같은 조건에서 영상 품질을 비교하려면 카메라와 연기 지시도 맞춰야 합니다.</p>
    <div class="study-links">
      <a class="text-link" href={path('review/reference-roles/evidence.json')} download>입력 필드·업로드 해시·프레임 기록 ↗</a>
      {evidence.source_ids.map(id => <a class="text-link" href={path(`prompts/?page=${id.split('-p')[0]}#${id}`)}>{id} 원문 ↗</a>)}
    </div>
  </section>
</Base>
<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.study-video')];
  const results = document.querySelectorAll<HTMLVideoElement>('video[data-result]');
  const controls = document.querySelector<HTMLElement>('.result-cues');
  if (controls) {
    controls.hidden = false;
    controls.querySelectorAll<HTMLButtonElement>('[data-result-time]').forEach(button => {
      button.addEventListener('click', () => {
        const seconds = Number(button.dataset.resultTime);
        results.forEach(video => {
          video.pause();
          if (seconds > 0 && video.readyState === HTMLMediaElement.HAVE_NOTHING) video.preload = 'metadata';
          video.currentTime = seconds;
        });
      });
    });
  }
  for (const video of videos) {
    video.addEventListener('play', () => {
      for (const other of videos) if (other !== video) other.pause();
    });
  }
</script>
<style>
  figure { margin: 0; min-width: 0; }
  img, video { display: block; width: 100%; height: auto; }
  video { background: var(--surface); }
  figcaption { margin-block: .55rem; font-size: .85rem; color: var(--muted); }
  .slots { display: flex; flex-wrap: wrap; gap: .7rem 2rem; margin-block: 1.1rem; }
  .slots dt { color: var(--accent); }
  .slots dd { margin: .25rem 0 0; }
  .result-cues:not([hidden]) { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .result-cues button { min-height: 44px; padding: .5rem .65rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line); font: inherit; cursor: pointer; }
  .sample-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; margin-block: 1rem; }
  details { margin-block: 1rem; }
  summary { cursor: pointer; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
