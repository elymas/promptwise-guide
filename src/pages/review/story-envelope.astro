---
import Base from '../../layouts/Base.astro';
import { path } from '../../data/topics';
import prompts from '../../../public/review/acting-v2/prompts.json';
const folder = 'review/story-envelope/';
const input = prompts.find(prompt => prompt.id === 'ACT-06');
const studies = [
  {
    id: 'E22',
    title: '“찾았어”가 가리키는 것을 첫 화면에 놓기',
    time: '0.00초',
    stills: [
      { name: 'wide-opening', caption: 'A · Claire의 얼굴과 작업실이 먼저 읽히는 구도' },
      { name: 'insert-opening', caption: 'B · 봉투와 두 사람의 손으로 시작' },
    ],
    observation: '두 버전에서 같은 시점에 Claire의 “찾았어”가 들립니다. A에서도 테이블 위 봉투가 보이고, B에서는 봉투가 화면 중앙을 크게 차지해 대사가 가리키는 물건을 먼저 읽을 수 있습니다. B의 1.50초 컷에서 얼굴과 작업실이 드러납니다.',
  },
  {
    id: 'E24',
    title: '마지막 화면에서 첫 물건을 다시 보여 주기',
    time: '7.00초',
    stills: [
      { name: 'wide-ending', caption: 'A · Erin이 안도한 표정으로 끝남' },
      { name: 'insert-ending', caption: 'B · 처음 본 빨간 봉투가 다시 화면의 중심에 옴' },
    ],
    observation: '두 버전은 봉투로 시작해 같은 대사와 Erin의 반응을 보여 줍니다. A는 Erin의 얼굴에 시선을 남깁니다. B는 6.50초부터 봉투를 다시 보여 주어, 처음의 물건이 끝에도 두 사람 사이에 그대로 놓여 있음을 확인할 수 있습니다.',
  },
];
---
<Base title="빨간 봉투의 첫 화면과 마지막 화면 — FRAME / NOTES" description="같은 Tein 테이크에서 첫 화면의 이야기 단서와 마지막 화면의 소품 회수를 소리 있는 편집 A/B로 비교합니다.">
  <section class="shell page-heading">
    <h1>빨간 봉투로 열고,<br />빨간 봉투로 닫다</h1>
    <p>Claire가 “찾았어”라고 말하고 Erin이 안도하는 8초 장면입니다. 같은 ACT-06 영상과 원음에서 특정 구간의 화면만 잘라, 첫 화면과 마지막 화면의 역할을 각각 비교했습니다.</p>
  </section>
  {studies.map(study => (
    <section class="shell coverage-section">
      <h2>{study.title}</h2>
      <div class="frames">
        {study.stills.map(still => (
          <figure>
            <img src={path(`${folder}media/${still.name}.jpg`)} width="854" height="480" loading="lazy" alt={still.caption} />
            <figcaption>{study.time} · {still.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p>{study.observation}</p>
      <a class="text-link" href={path(`examples/#compare-${study.id}`)}>소리와 함께 {study.id} A/B 보기 ↗</a>
    </section>
  ))}
  <section class="shell coverage-section">
    <h2>원본과 편집 조건</h2>
    <p>세 버전 모두 854 × 480, 192프레임입니다. 인서트는 원본에서 잘라 확대했기 때문에 디테일의 해상도는 원본 크롭 영역에 따릅니다. 편집본의 음성 데이터는 원본과 같습니다. 봉투를 찾은 뒤 이어지는 장면을 다룬 작업이며, 빗속에서 악보를 구하는 문제·선택·결과 장면은 별도 제작안입니다.</p>
    {input?.video && <details class="comparison-inputs"><summary>Tein에 사용한 ACT-06 영상 입력문</summary><pre>{input.video}</pre></details>}
    <div class="study-links">
      <a class="text-link" href={path(folder + 'edit.json')} download>편집 범위와 원본 해시 ↗</a>
      <a class="text-link" href={path('review/acting-v2/#ACT-06')}>ACT-06 원본 ↗</a>
      <a class="text-link" href={path('prompts/?page=PW-106#PW-106-p5')}>이야기와 소품 회수 원문 ↗</a>
    </div>
  </section>
</Base>
<style>
  .frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: .55rem; font-size: .85rem; color: var(--muted); }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 520px) { .frames { grid-template-columns: 1fr; } }
</style>
